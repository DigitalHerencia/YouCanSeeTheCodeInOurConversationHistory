filters:
  and:
    - file.ext == "md"
    - not:
        - file.inFolder("_obsidian/Templates")
        - file.inFolder("90 OBSIDIAN/Templates")
        - file.inFolder("DevNotes-Unified-Knowledge-Engineering-System-Authority-Package-v0.1.0/03-templates")
        - file.inFolder("DevNotes-Unified-Knowledge-Engineering-System-Authority-Package-v0.1.0/07-vault-overlay")
        - file.inFolder("10 PROJECTS/10.PROJECTS.CODEPENDENTCODING/10.PROJECTS.CODEPENDENTCODING.Source Mirror")
    - or:
        - system == "codependent-coding"
        - workspace == "codependent-coding"
        - file.inFolder("60 CODEPENDENT CODING")
        - file.inFolder("10 PROJECTS/10.PROJECTS.CODEPENDENTCODING")
properties:
  file.name:
    displayName: Artifact
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  system:
    displayName: System
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
  source_kind:
    displayName: Source Kind
views:
  - type: table
    name: Workspace
    order: [file.name, role, type, status, authority, source_kind]
  - type: table
    name: Role Lenses
    filters:
      and:
        - workspace == "codependent-coding"
        - type == "map"
    groupBy:
      property: role
      direction: ASC
    order: [role, file.name, type, status, authority]
  - type: table
    name: Canon
    filters:
      or:
        - authority == "canonical"
        - authority == "source-of-truth"
    order: [file.name, role, type, status, authority]
