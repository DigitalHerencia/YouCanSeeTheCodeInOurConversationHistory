filters:
  and:
    - file.ext == "md"
    - file.hasProperty("namespace")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  system:
    displayName: System
  workspace:
    displayName: Workspace
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing

views:
  - type: table
    name: Knowledge Index
    order: [file.name, role, workspace, system, type, status, authority, formula.backlink_count, formula.outgoing_link_count]
  - type: table
    name: Canon
    filters:
      and:
        - authority == "canonical"
    order: [file.name, role, system, type, status, formula.backlink_count]
  - type: table
    name: Legacy Source of Truth
    filters:
      and:
        - authority == "source-of-truth"
    order: [file.name, project, domain, type, status, formula.backlink_count]
  - type: table
    name: Link Health
    filters:
      or:
        - file.backlinks.length == 0
        - file.links.length == 0
    order: [file.name, role, workspace, type, authority, formula.backlink_count, formula.outgoing_link_count]
