filters:
  and:
    - file.ext == "md"
    - file.hasProperty("namespace")
    - not:
        - file.inFolder("_obsidian/Templates")
        - file.inFolder("90 OBSIDIAN/Templates")
        - file.inFolder("DevNotes-Unified-Knowledge-Engineering-System-Authority-Package-v0.1.0/03-templates")
        - file.inFolder("DevNotes-Unified-Knowledge-Engineering-System-Authority-Package-v0.1.0/07-vault-overlay")
        - file.inFolder("10 PROJECTS/10.PROJECTS.CODEPENDENTCODING/10.PROJECTS.CODEPENDENTCODING.Source Mirror")
        - file.inFolder("_ops")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
  connection_health: 'if(file.backlinks.length == 0 || file.links.length == 0, "weak", "connected")'
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  type:
    displayName: Type
  status:
    displayName: Status
  health:
    displayName: Health
  authority:
    displayName: Authority
  formula.connection_health:
    displayName: Connections
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing
views:
  - type: table
    name: System Health
    filters:
      or:
        - type == "capture"
        - status == "blocked"
        - health == "at-risk"
        - file.backlinks.length == 0
        - file.links.length == 0
    order:
      - file.name
      - role
      - workspace
      - type
      - status
      - health
      - formula.connection_health
      - formula.backlink_count
      - formula.outgoing_link_count
    sort:
      - property: formula.backlink_count
        direction: ASC
      - property: formula.outgoing_link_count
        direction: ASC
  - type: table
    name: Blocked or At Risk
    filters:
      or:
        - status == "blocked"
        - health == "at-risk"
    order:
      - file.name
      - role
      - workspace
      - status
      - health
      - type
  - type: table
    name: Weak Links
    filters:
      or:
        - file.backlinks.length == 0
        - file.links.length == 0
    order:
      - file.name
      - role
      - workspace
      - type
      - authority
      - formula.backlink_count
      - formula.outgoing_link_count
