filters:
  and:
    - file.ext == "md"
    - file.hasProperty("namespace")
    - not:
        - file.inFolder("_obsidian/Templates")
        - file.inFolder("90 OBSIDIAN/Templates")
        - file.inFolder("DevNotes-Unified-Knowledge-Engineering-System-Authority-Package-v0.1.0/03-templates")
        - file.inFolder("DevNotes-Unified-Knowledge-Engineering-System-Authority-Package-v0.1.0/07-vault-overlay")
        - file.inFolder("10 PROJECTS/10.PROJECTS.CODEPENDENTCODING/10.PROJECTS.CODEPENDENTCODING.Source Mirror")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  system:
    displayName: System
  workspace:
    displayName: Workspace
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing

views:
  - type: table
    name: Active Handoffs
    filters:
      and:
        - type == "handoff"
        - status != "done"
    order: [file.name, workspace, role, status, formula.backlink_count]
