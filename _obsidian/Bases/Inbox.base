filters:
  and:
    - file.ext == "md"
    - file.hasProperty("namespace")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  system:
    displayName: System
  workspace:
    displayName: Workspace
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing

views:
  - type: table
    name: Inbox
    filters:
      and:
        - type == "capture"
    order: [file.name, workspace, status, formula.backlink_count]
