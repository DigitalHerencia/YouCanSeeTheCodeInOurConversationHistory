{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevNotes Note Metadata",
  "type": "object",
  "required": [
    "title",
    "role",
    "type",
    "status",
    "authority",
    "created",
    "updated"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "Chief of Staff",
        "Trust Issues",
        "Execution",
        "Vibes",
        "DevNotes",
        "Schemes",
        "Prömpter",
        "Fuck You Pay Me"
      ]
    },
    "system": {
      "type": ["string", "null"]
    },
    "workspace": {
      "type": ["string", "null"]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "Draft",
        "Review",
        "Active",
        "Superseded",
        "Archived",
        "Backlog",
        "Ready",
        "In Progress",
        "Blocked",
        "Done",
        "Cancelled"
      ]
    },
    "authority": {
      "enum": [
        "Source of Truth",
        "Working",
        "Reference",
        "Derived",
        "Historical"
      ]
    },
    "health": {
      "enum": [
        "On Track",
        "At Risk",
        "Blocked",
        "Paused"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "part_of": { "$ref": "#/$defs/relationships" },
    "depends_on": { "$ref": "#/$defs/relationships" },
    "implements": { "$ref": "#/$defs/relationships" },
    "refines": { "$ref": "#/$defs/relationships" },
    "validates": { "$ref": "#/$defs/relationships" },
    "evidence_for": { "$ref": "#/$defs/relationships" },
    "derived_from": { "$ref": "#/$defs/relationships" },
    "supersedes": { "$ref": "#/$defs/relationships" },
    "governed_by": { "$ref": "#/$defs/relationships" },
    "connects_to": { "$ref": "#/$defs/relationships" }
  },
  "$defs": {
    "relationships": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      ]
    }
  },
  "additionalProperties": true
}
