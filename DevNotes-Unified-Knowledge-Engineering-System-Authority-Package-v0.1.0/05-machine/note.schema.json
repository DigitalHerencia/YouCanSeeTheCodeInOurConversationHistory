{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DevNotes Unified Note Metadata",
  "type": "object",
  "required": [
    "title",
    "namespace",
    "role",
    "system",
    "type",
    "status",
    "authority",
    "created",
    "updated"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "chief-of-staff",
        "trust-issues",
        "execution",
        "vibes",
        "devnotes",
        "schemes",
        "prompter",
        "fuck-you-pay-me"
      ]
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "workspace": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "enum": [
        "canonical",
        "supporting",
        "implementation-evidence",
        "project-specific",
        "operational"
      ]
    },
    "created": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}