views:
  - type: table
    name: Table
    filters:
      and:
        - 'source_path.startsWith("The Hipster Stack™ Technology Stack\\apps\\web")'
    sort:
      - property: file.name
        direction: ASC
    cardSize: 350
  - type: table
    name: View
    filters:
      and:
        - 'source_path.startsWith("The Hipster Stack™ Technology Stack\\apps\\web")'
