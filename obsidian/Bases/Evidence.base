filters:
  and:
    - file.ext == "md"
    - not:
        - file.inFolder("obsidian/Templates")
        - file.inFolder("ZETTLECASTEN")
        - file.inFolder("CIGARETTES, REGRETS, & NEURAL NETS")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  system:
    displayName: System
  workspace:
    displayName: Workspace
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing
views:
  - type: table
    name: Evidence
    filters:
      or:
        - type == "verification"
        - file.hasTag("evidence")
        - file.hasTag("verification")
    order:
      - file.name
      - workspace
      - role
      - status
      - authority
      - formula.backlink_count
