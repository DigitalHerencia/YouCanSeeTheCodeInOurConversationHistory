filters:
  and:
    - file.ext == "md"
    - file.hasProperty("namespace")
    - not:
        - file.inFolder("_obsidian/Templates")
        - file.inFolder("_ops")
        - file.inFolder("DevNotes/Archive")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
  connection_health: if(file.backlinks.length == 0 || file.links.length == 0, "weak", "connected")
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  type:
    displayName: Type
  status:
    displayName: Status
  health:
    displayName: Health
  authority:
    displayName: Authority
  formula.connection_health:
    displayName: Connections
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing
views:
  - type: table
    name: Operational Health
    filters:
      or:
        - type == "capture"
        - status == "blocked"
        - health == "at-risk"
    order:
      - file.name
      - role
      - workspace
      - type
      - status
      - health
  - type: table
    name: Blocked or At Risk
    filters:
      or:
        - status == "blocked"
        - health == "at-risk"
    order:
      - file.name
      - role
      - workspace
      - status
      - health
      - type
  - type: table
    name: Graph Review
    filters:
      or:
        - file.backlinks.length == 0
        - file.links.length == 0
    order:
      - file.name
      - role
      - workspace
      - type
      - authority
      - formula.backlink_count
      - formula.outgoing_link_count
