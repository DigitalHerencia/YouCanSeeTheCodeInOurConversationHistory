filters:
  and:
    - file.ext == "md"
    - file.hasProperty("role")
    - not:
        - file.inFolder("_obsidian/Templates")
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  system:
    displayName: System
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
views:
  - type: table
    name: Role Knowledge
    groupBy:
      property: role
      direction: ASC
    order:
      - role
      - file.name
      - workspace
      - system
      - type
      - status
      - authority
  - type: cards
    name: Role Domains
    order:
      - file.name
      - role
      - workspace
      - system
      - type
      - status
