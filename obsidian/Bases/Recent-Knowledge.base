filters:
  and:
    - file.ext == "md"
    - file.hasProperty("role")
    - not:
        - file.inFolder("obsidian/Templates")
        - file.inFolder("ops")
        - file.inFolder("DevNotes/Archive")
        - file.inFolder("ZETTLECASTEN")
        - file.inFolder("CIGARETTES, REGRETS, & NEURAL NETS")
properties:
  file.name:
    displayName: Note
  file.mtime:
    displayName: Modified
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  system:
    displayName: System
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
views:
  - type: table
    name: Recent Knowledge
    filters:
      or:
        - authority == "Source of Truth"
        - authority == "Working"
        - authority == "Reference"
        - type == "research"
        - type == "decision"
    order:
      - file.name
      - role
      - workspace
      - type
      - status
      - authority
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 25
