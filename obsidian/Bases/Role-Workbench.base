filters:
  and:
    - file.ext == "md"
    - file.hasProperty("role")
    - role == this.role
    - not:
        - file.inFolder("_obsidian/Templates")
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  system:
    displayName: System
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
views:
  - type: table
    name: Role Workbench
    order:
      - file.name
      - workspace
      - system
      - type
      - status
      - authority
    sort:
      - property: workspace
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Active Work
    filters:
      or:
        - status == "ready"
        - status == "in-progress"
        - status == "in-review"
        - status == "blocked"
    order:
      - file.name
      - workspace
      - type
      - status
      - authority
  - type: table
    name: Canon
    filters:
      and:
        - authority == "canonical"
    order:
      - file.name
      - system
      - type
      - status
