filters:
  and:
    - file.ext == "md"
    - file.hasProperty("role")
formulas:
  backlink_count: file.backlinks.length
  outgoing_link_count: file.links.length
properties:
  file.name:
    displayName: Note
  role:
    displayName: Role
  workspace:
    displayName: Workspace
  system:
    displayName: System
  type:
    displayName: Type
  status:
    displayName: Status
  authority:
    displayName: Authority
  tags:
    displayName: Tags
  part_of:
    displayName: Part Of
  depends_on:
    displayName: Dependencies
  formula.backlink_count:
    displayName: Backlinks
  formula.outgoing_link_count:
    displayName: Outgoing Links
views:
  - type: table
    name: Knowledge Index
    order:
      - file.name
      - role
      - workspace
      - system
      - type
      - status
      - authority
      - formula.backlink_count
      - formula.outgoing_link_count
      - tags
    sort: []
  - type: table
    name: Link Health
    filters:
      or:
        - file.backlinks.length == 0
        - file.links.length == 0
    order:
      - file.name
      - role
      - workspace
      - type
      - status
      - authority
      - part_of
      - depends_on
      - tags
      - formula.backlink_count
      - formula.outgoing_link_count
    sort:
      - property: formula.backlink_count
        direction: ASC
      - property: formula.outgoing_link_count
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Source of Truth
    filters:
      and:
        - authority == "Source of Truth"
    order:
      - file.name
      - role
      - workspace
      - system
      - type
      - status
      - formula.backlink_count
      - formula.outgoing_link_count
    sort:
      - property: role
        direction: ASC
      - property: file.name
        direction: ASC
  - type: table
    name: Maps
    filters:
      and:
        - type == "map"
    order:
      - file.name
      - role
      - workspace
      - authority
      - part_of
      - depends_on
      - tags
      - formula.backlink_count
      - formula.outgoing_link_count
    sort:
      - property: role
        direction: ASC
      - property: file.name
        direction: ASC
  - type: list
    name: View
    indentProperties: true
