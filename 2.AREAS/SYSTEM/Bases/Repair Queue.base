filters:
  and:
    - file.inFolder("2.AREAS/SYSTEM/_Tasks")
    - file.hasTag("hearth/repair")
    - migration_relation_state == "manifest-confirmed-orphan"
properties:
  file.name:
    displayName: Task
views:
  - type: table
    name: Unlinked source tasks
    order: [file.name, status, source_path, source_identity]
