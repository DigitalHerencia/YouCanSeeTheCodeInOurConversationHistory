filters:
  and:
    - 'type == "pattern"'
    - 'file.inFolder("3.RESOURCES")'
    - 'technology != null'
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: "Patterns by Technology"
    order:
      - file.name
      - technology
      - pattern_status
      - resource_state
      - project_links
