filters:
  and:
    - 'type == "task"'
    - 'file.inFolder("2.AREAS/SYSTEM/_Tasks")'
    - 'status == "done"'
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: "Tasks Recently Completed"
    order:
      - file.name
      - completed_at
      - project
      - phase
      - task_code
