filters:
  and:
    - 'type != "lesson"'
    - 'file.inFolder("2.AREAS/CODE")'
    - 'mastery_state != "mastered"'
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: "CodeLab Current"
    order:
      - file.name
      - type
      - domain
      - dev_cycle
      - standard
      - pattern
      - status
