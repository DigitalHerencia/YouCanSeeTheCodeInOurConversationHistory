filters:
  and:
    - 'type == "resource"'
    - 'file.inFolder("3.RESOURCES")'
    - 'resource_state == "active"'
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: "Resources Active"
    order:
      - file.name
      - authority
      - resource_role
      - review_due
      - project_links

