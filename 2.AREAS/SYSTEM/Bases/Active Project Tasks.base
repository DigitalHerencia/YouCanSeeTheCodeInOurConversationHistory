filters:
  and:
    - 'type == "task"'
    - 'file.inFolder("2.AREAS/SYSTEM/_Tasks")'
    - 'project == this.project'
properties:
  file.name:
    displayName: Name
views:
  - type: table
    name: "Active Project Tasks"
    order:
      - project
      - phase
      - milestone
      - status
      - priority
      - due
      - scheduled
      - estimate
      - blocker

