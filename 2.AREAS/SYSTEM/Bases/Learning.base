filters:
  and:
    - file.inFolder("3.RESOURCES")
    - file.hasTag("domain/typescript")
    - archived != true
properties:
  file.name:
    displayName: Item
  status:
    displayName: Status
  progress:
    displayName: Progress
  file.tags:
    displayName: Tags
views:
  - type: table
    name: Study Queue
    order:
      - file.name
      - status
      - progress
      - file.tags
