# DevNotes / Obsidian vault gitignore
# Keep durable notes, templates, contracts, maps, scripts, and agent logs versioned.
# Ignore local UI state, caches, plugin binaries, temp files, and machine-specific noise.

# -----------------------------
# OS / editor noise
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.temp
*.swp
*.swo
*.bak
*.orig
*~

# -----------------------------
# Local env / secrets
# -----------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
secrets.*
*.secret.*

# -----------------------------
# Logs / runtime output
# -----------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep .agent-logs tracked intentionally.
# Agents use this history to understand prior vault operations.
!.agent-logs/
!.agent-logs/events.jsonl

# -----------------------------
# Git internals
# -----------------------------
.git/

# -----------------------------
# Obsidian local UI state
# -----------------------------
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache
.obsidian/plugins/*/cache/
.obsidian/plugins/*/.cache/

# Keep useful Obsidian settings tracked.
!.obsidian/app.json
!.obsidian/appearance.json
!.obsidian/backlink.json
!.obsidian/community-plugins.json
!.obsidian/core-plugins.json
!.obsidian/graph.json
!.obsidian/hotkeys.json
!.obsidian/templates.json
!.obsidian/types.json

# -----------------------------
# Obsidian plugin packages
# -----------------------------
# Keep plugin manifests/configs, ignore downloaded plugin bundles.
.obsidian/plugins/*/main.js
.obsidian/plugins/*/styles.css

!.obsidian/plugins/*/manifest.json
!.obsidian/plugins/*/data.json

# -----------------------------
# Obsidian themes
# -----------------------------
# Keep theme manifest, ignore downloaded theme CSS unless intentionally customized.
.obsidian/themes/*/theme.css
!.obsidian/themes/*/manifest.json

# -----------------------------
# Trash / generated attachment dumps
# -----------------------------
.trash/
.obsidian-trash/

# -----------------------------
# Node / package manager noise if scripts grow later
# -----------------------------
node_modules/
.pnpm-store/
.npm/
.yarn/
dist/
build/
.next/
out/
coverage/

# -----------------------------
# Python noise if automation scripts grow later
# -----------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# -----------------------------
# Large binary drafts / exports
# -----------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.mp4
*.mov
*.avi
*.mkv
*.psd
*.ai
*.sketch

# Keep intentional vault reference images.
!20 DOCUMENTATION/**/*.png
!20 DOCUMENTATION/**/*.jpg
!20 DOCUMENTATION/**/*.jpeg
!20 DOCUMENTATION/**/*.webp