filters:
  and:
    - file.inFolder("1.PROJECTS/_Tasks")
    - file.hasTag("type/task")
    - archive != true
    - list(projects).map(file(value).asLink()).contains(file("1.PROJECTS/Vault Integration Check/Project.md").asLink())
properties:
  file.name:
    displayName: Task
views:
  - type: table
    name: Open Tasks
    filters:
      and:
        - status != "done"
        - status != "cancelled"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - due
      - projects
