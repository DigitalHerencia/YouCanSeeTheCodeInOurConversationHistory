filters:
  and:
    - 'file.inFolder("1.PROJECTS")'
    - 'file.hasTag("type/task")'
    - 'archive != true'
properties:
  file.name:
    displayName: Task
  status:
    displayName: Status
  priority:
    displayName: Priority
  due:
    displayName: Due
views:
  - type: table
    name: Open Tasks
    filters:
      and:
        - 'status != "done"'
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - priority
      - due
