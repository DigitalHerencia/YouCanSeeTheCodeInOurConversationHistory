filters:
  and:
    - 'file.inFolder("Digital Herencia/Projects")'
    - 'entity == "project"'
properties:
  file.name:
    displayName: Project
  team:
    displayName: Team
  status:
    displayName: Status
  work_start:
    displayName: Start
  work_end:
    displayName: End
  milestone:
    displayName: Milestone
  phase:
    displayName: Phase
views:
  - type: table
    name: Active Schedule
    filters:
      and:
        - 'status == "In progress"'
    order:
      - file.name
      - team
      - milestone
      - phase
      - work_start
      - work_end
  - type: table
    name: Full Schedule
    order:
      - file.name
      - team
      - status
      - milestone
      - phase
      - work_start
      - work_end
