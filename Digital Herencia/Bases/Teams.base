filters:
  and:
    - 'file.inFolder("Digital Herencia/Teams")'
    - 'entity == "team"'
properties:
  file.name:
    displayName: Team
  team_class:
    displayName: Class
  mandate:
    displayName: Mandate
views:
  - type: cards
    name: Team Functions
    order:
      - file.name
      - team_class
      - mandate
  - type: table
    name: All Teams
    order:
      - file.name
      - team_class
      - mandate
