filters:
  and:
    - 'file.ext == "md"'
properties:
  file.name:
    displayName: Note
  file.folder:
    displayName: Folder
  entity:
    displayName: Entity
  status:
    displayName: Status
  tags:
    displayName: Tags
views:
  - type: table
    name: Recently Modified
    limit: 50
    order:
      - file.name
      - file.folder
      - entity
      - status
      - file.mtime
  - type: table
    name: Existing Vault
    filters:
      not:
        - 'file.inFolder("Digital Herencia")'
    order:
      - file.name
      - file.folder
      - file.mtime
      - tags
  - type: table
    name: Digital Herencia
    filters:
      and:
        - 'file.inFolder("Digital Herencia")'
    order:
      - file.name
      - file.folder
      - entity
      - status
      - file.mtime
