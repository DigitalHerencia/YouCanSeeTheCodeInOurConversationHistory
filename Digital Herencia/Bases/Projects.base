filters:
  and:
    - 'file.inFolder("Digital Herencia/Projects")'
    - 'entity == "project"'
properties:
  file.name:
    displayName: Project
  status:
    displayName: Status
  team:
    displayName: Team
  domain:
    displayName: Domain
  milestone:
    displayName: Milestone
  phase:
    displayName: Phase
  work_start:
    displayName: Start
  work_end:
    displayName: End
  archived:
    displayName: Archived
views:
  - type: cards
    name: Status
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - team
      - milestone
      - phase
      - work_start
      - work_end
  - type: list
    name: By Team
    groupBy:
      property: team
      direction: ASC
    order:
      - file.name
      - status
      - milestone
      - phase
  - type: table
    name: All Projects
    order:
      - file.name
      - domain
      - team
      - milestone
      - phase
      - status
      - work_start
      - work_end
      - archived
