filters:
  and:
    - 'file.inFolder("Digital Herencia/Portfolio")'
    - 'entity == "portfolio-item"'
properties:
  file.name:
    displayName: Item
  status:
    displayName: Status
  team:
    displayName: Team
  project:
    displayName: Project
  parent_item:
    displayName: Parent
views:
  - type: table
    name: Active Portfolio
    filters:
      not:
        - 'status == "Done"'
    order:
      - file.name
      - status
      - team
      - project
      - parent_item
  - type: table
    name: Done
    filters:
      and:
        - 'status == "Done"'
    order:
      - file.name
      - team
      - project
